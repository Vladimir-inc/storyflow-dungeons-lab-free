{{!-- Right-click context menu, rendered ALONE via render({parts:["contextmenu"]}). The root
      <menu> is ALWAYS present (hidden when closed) so the PART always has a single root
      element - an empty PART makes AppV2's render throw. Mirrors the palette popover. --}}
<menu class="storyflow-context-menu {{#unless contextMenu.open}}storyflow-hidden{{/unless}}"
      style="left:{{contextMenu.x}}px; top:{{contextMenu.y}}px;">
  {{#if contextMenu.open}}
    {{#each contextMenu.items}}
    <li>
      <button type="button" class="storyflow-context-item" data-action="{{this.action}}" {{#if this.disabled}}disabled{{/if}}>
        <i class="{{this.icon}}"></i>
        <span>{{this.label}}</span>
      </button>
    </li>
    {{/each}}
  {{/if}}
</menu>
