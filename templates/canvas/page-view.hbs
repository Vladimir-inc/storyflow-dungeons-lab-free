{{!-- Polished inline view of a StoryFlow graph page inside the Journal app. --}}
<div class="storyflow-graph-page-summary">
  <div class="storyflow-graph-banner {{#unless hasImg}}storyflow-graph-banner-fire{{/unless}}">
    {{#if hasImg}}
      <img src="{{img}}" alt="" />
    {{/if}}
    <div class="storyflow-graph-banner-scrim">
      <i class="fa-solid fa-diagram-project storyflow-graph-icon"></i>
      <h3>{{document.name}}</h3>
      {{#if categoryName}}<span class="storyflow-graph-category">{{categoryName}}</span>{{/if}}
    </div>
    {{#if canEdit}}
      <div class="storyflow-graph-banner-tools">
        <button type="button" class="storyflow-graph-cover-btn" data-action="toggleEdit"
                title="{{localize 'STORYFLOW_DUNGEONS_LAB.GraphPage.EnterEdit'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
      </div>
    {{/if}}
  </div>

  <div class="storyflow-graph-pills">
    <span class="storyflow-graph-pill">{{localize "STORYFLOW_DUNGEONS_LAB.GraphPage.NodeCount" count=nodeCount}}</span>
    <span class="storyflow-graph-pill">{{localize "STORYFLOW_DUNGEONS_LAB.GraphPage.EdgeCount" count=edgeCount}}</span>
    {{#if danglingCount}}
      <span class="storyflow-graph-pill storyflow-graph-pill-warn">{{localize "STORYFLOW_DUNGEONS_LAB.GraphPage.Dangling" count=danglingCount}}</span>
    {{/if}}
  </div>

  {{#if description}}
    <div class="storyflow-graph-description">{{{description}}}</div>
  {{/if}}

  <div class="storyflow-graph-rule"></div>

  <div class="storyflow-graph-actions">
    <button type="button" class="storyflow-graph-btn-primary" data-action="openEditor">
      <i class="fa-solid fa-pen-to-square"></i> {{localize "STORYFLOW_DUNGEONS_LAB.GraphPage.OpenEditor"}}
    </button>
    {{#if isGM}}
      <button type="button" class="storyflow-graph-btn-secondary" data-action="startFlow">
        <i class="fa-solid fa-play"></i> {{localize "STORYFLOW_DUNGEONS_LAB.GraphPage.StartFlow"}}
      </button>
    {{/if}}
  </div>
</div>
