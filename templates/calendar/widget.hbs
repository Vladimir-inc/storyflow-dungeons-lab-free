<div class="storyflow-calendar-bar" data-action="openCalendar" data-tooltip="{{tooltip}}">
  <div class="cw-sky" data-cond="{{cond}}" style="background:{{skyGradient}};">
    {{#if showStars}}
      <div class="cw-stars">
        {{#each stars}}<span
            style="left:{{this.left}}%; top:{{this.top}}%; width:{{this.size}}px; height:{{this.size}}px; animation-delay:{{this.delay}};"
          ></span>{{/each}}
      </div>
    {{/if}}
    {{#if isNight}}
      <div
        class="cw-cel"
        style="left:{{celestialLeft}}%; top:{{celestialTop}}%; opacity:{{celestialOpacity}};"
      >
        <div class="cw-moon">
          <svg width="18" height="18" viewBox="0 0 24 24"><circle
              cx="12"
              cy="12"
              r="10"
              fill="#211D2B"
            ></circle><path d="{{moonD}}" fill="#D9D2C0"></path></svg>
        </div>
      </div>
    {{else}}
      <div
        class="cw-cel"
        style="left:{{celestialLeft}}%; top:{{celestialTop}}%; opacity:{{celestialOpacity}};"
      >
        {{#if showRays}}<div class="cw-rays"></div>{{/if}}
        <div class="cw-sun"></div>
      </div>
    {{/if}}
    <div class="cw-tint"></div>
    {{#if showClouds}}
      <div class="cw-clouds">
        {{#each clouds}}<span
            style="left:{{this.left}}%; top:{{this.top}}%; width:{{this.w}}px; height:{{this.h}}px; opacity:{{this.alpha}}; animation-duration:{{this.dur}}s;"
          ></span>{{/each}}
      </div>
    {{/if}}
    {{#if showFog}}
      <div class="cw-fog"><span></span><span></span><span></span></div>
    {{/if}}
    {{#if showRain}}
      <div class="cw-rain">
        {{#each drops}}<span
            style="left:{{this.left}}%; height:{{this.len}}px; opacity:{{this.op}}; animation-duration:{{this.dur}}s; animation-delay:{{this.delay}}s;"
          ></span>{{/each}}
      </div>
    {{/if}}
    {{#if showSnow}}
      <div class="cw-snow">
        {{#each flakes}}<span
            style="left:{{this.left}}%; width:{{this.size}}px; height:{{this.size}}px; opacity:{{this.op}}; animation-duration:{{this.dur}}s; animation-delay:{{this.delay}}s;"
          ></span>{{/each}}
      </div>
    {{/if}}
    {{#if showFlash}}<div class="cw-flash"></div>{{/if}}
    <div class="cw-ridge"></div>
    <div class="cw-ridge-glow"></div>
    <span class="cw-time">{{timeText}}</span>
    <span class="cw-cond">{{condLabel}}</span>
    {{! Показания перемотки неба - скрыты, пока ГМ не тянет небо (на корне появляется .scrubbing). Текст
        обновляется вживую точечными записями в DOM из calendar-widget.mjs (scrubPreview). }}
    <div class="cw-scrub" aria-hidden="true">
      <span class="cw-scrub-time">{{timeText}}</span>
      <div class="cw-scrub-marks">
        <span>{{scrubMark0}}</span>
        <span>{{scrubMark2}}</span>
      </div>
    </div>
  </div>
  <div class="cw-date">
    <span class="cw-date-line">{{dateLine}}</span>
    <span class="cw-date-sub">{{dateSubline}}</span>
  </div>
  <div class="cw-moonphase" data-tooltip="{{moonLabel}}">
    <svg width="26" height="26" viewBox="0 0 24 24"><circle
        cx="12"
        cy="12"
        r="10"
        fill="#1A1722"
        stroke="var(--storyflow-border-strong)"
        stroke-width="1"
      ></circle><path d="{{moonD}}" fill="#D9D2C0"></path></svg>
  </div>
  <div class="cw-weather" data-tooltip="{{weatherTip}}">
    <i class="fa-solid {{weatherIcon}}" aria-hidden="true" style="color:{{weatherColor}};"></i>
    <span>{{weatherTemp}}</span>
  </div>
  <i class="fa-solid fa-chevron-down cw-chevron" aria-hidden="true"></i>
</div>
{{#if isGM}}
  <div class="storyflow-calendar-tray">
    <button type="button" data-action="jumpDawn" data-tooltip="{{trayDawnTip}}"><i
        class="fa-solid fa-mountain-sun"
        aria-hidden="true"
      ></i>{{trayDawn}}</button>
    {{! Сначала шаги − (от большего к меньшему, так как −2w < −5m), затем шаги + (от меньшего к большему). }}
    {{#each trayStepsDesc}}
      <button
        type="button"
        data-action="stepTime"
        data-seconds="{{this.minusSeconds}}"
      >−{{this.label}}</button>
    {{/each}}
    {{#each traySteps}}
      <button
        type="button"
        data-action="stepTime"
        data-seconds="{{this.plusSeconds}}"
      >+{{this.label}}</button>
    {{/each}}
    <button type="button" data-action="jumpDusk" data-tooltip="{{trayDuskTip}}"><i
        class="fa-solid fa-moon"
        aria-hidden="true"
      ></i>{{trayDusk}}</button>
    <button type="button" data-action="advanceDay" data-tooltip="{{trayDayTip}}"><i
        class="fa-solid fa-calendar-plus"
        aria-hidden="true"
      ></i>{{trayDay}}</button>
  </div>
{{/if}}