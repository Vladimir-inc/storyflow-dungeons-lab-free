{{!-- GM-side runtime target picker for the Heal/Damage node. Rendered into a
      DialogV2 via renderTemplate so actor names are Handlebars-escaped (the
      module never assembles HTML strings in JS). --}}
<div class="storyflow-target-picker">
  {{#each actors}}
    <label class="storyflow-target-option">
      <input type="checkbox" name="targetActorIds" value="{{this.id}}" />
      <span>{{this.name}}</span>
    </label>
  {{/each}}
</div>
