{{!-- Вкладка лора: боковая панель при свечах (строки карточек по категориям) и деталь. ГМ правит на месте. --}}
<section class="storyflow-qb-content qb-lore {{#if isActive}}active{{/if}}">
  <div class="qb-body">
    <aside class="qb-side">
      <div class="qb-side-head">
        <span class="qb-count">{{loreCountLabel}}</span>
        {{#if isGM}}
          <button type="button" class="qb-side-add" data-action="addCategory" data-catkind="lore">
            <i class="fa-solid fa-plus"></i> {{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.CategoryShort"}}
          </button>
        {{/if}}
      </div>
      <div class="qb-rows">
        {{#each loreCategories}}
          {{#unless this.isGeneral}}
            <div class="qb-cat-head">
              <i class="fa-solid fa-bookmark qb-cat-bookmark"></i>
              <span class="qb-cat-name">{{this.name}}</span>
              {{#if ../isGM}}
                <span class="qb-cat-controls">
                  <i class="fa-solid fa-chevron-up" data-action="moveCategoryUp" data-catkind="lore" data-catid="{{this.id}}"></i>
                  <i class="fa-solid fa-chevron-down" data-action="moveCategoryDown" data-catkind="lore" data-catid="{{this.id}}"></i>
                  <i class="fa-solid fa-pen" data-action="renameCategory" data-catkind="lore" data-catid="{{this.id}}"></i>
                  <i class="fa-solid fa-trash" data-action="removeCategory" data-catkind="lore" data-catid="{{this.id}}"></i>
                </span>
              {{/if}}
              <span class="qb-cat-count">{{this.entries.length}}</span>
            </div>
            {{#unless this.entries.length}}
              <div class="qb-cat-empty">{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.NoEntries"}}</div>
            {{/unless}}
          {{/unless}}
          {{#each this.entries}}
            <div class="qb-row {{#if (eq this.uuid ../../selectedLore.uuid)}}is-selected{{/if}} {{#if this.hidden}}is-hidden{{/if}} {{#if this.unread}}is-announced{{/if}}"
                 data-action="selectEntry" data-kind="lore" data-uuid="{{this.uuid}}">
              <i class="fa-solid fa-book-open qb-row-icon"></i>
              <div class="qb-row-main">
                <div class="qb-row-name">{{this.name}}</div>
              </div>
              {{#if ../../isGM}}
                {{#if this.unread}}<i class="fa-solid fa-bell qb-bell" data-tooltip="{{localize 'STORYFLOW_DUNGEONS_LAB.QuestBoard.AnnouncedHint'}}"></i>{{/if}}
                {{#if this.hidden}}<i class="fa-solid fa-eye-slash qb-eye-ind" data-tooltip="{{localize 'STORYFLOW_DUNGEONS_LAB.QuestBoard.HiddenHint'}}"></i>{{/if}}
              {{else}}
                {{#if this.unread}}<span class="qb-dot" data-tooltip="{{localize 'STORYFLOW_DUNGEONS_LAB.QuestBoard.UnreadHint'}}"></span>{{/if}}
              {{/if}}
            </div>
          {{/each}}
        {{/each}}
      </div>
    </aside>

    <div class="qb-detail" data-kind="lore" data-uuid="{{selectedLore.uuid}}">
      {{#if selectedLore}}
        <div class="qb-kicker">{{selectedLore.categoryName}}</div>
        <div class="qb-title-row">
          {{#if isGM}}
            <input type="text" class="qb-name-input" data-edit="name" value="{{selectedLore.name}}" />
          {{else}}
            <h2>{{selectedLore.name}}</h2>
          {{/if}}
        </div>
        <div class="qb-rule"></div>

        {{#if isGM}}
          <div class="qb-toolbar">
            <label>{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.Category"}}</label>
            <select data-edit="category">
              <option value="">{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.General"}}</option>
              {{#each selectedLore.categoryOptions}}
                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
            <button type="button" class="qb-btn" data-action="toggleReveal" data-uuid="{{selectedLore.uuid}}"
                    data-tooltip="{{localize 'STORYFLOW_DUNGEONS_LAB.QuestBoard.ToggleReveal'}}">
              <i class="fa-solid {{#if selectedLore.hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
              {{#if selectedLore.hidden}}{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.HiddenLabel"}}{{else}}{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.VisibleLabel"}}{{/if}}
            </button>
            <button type="button" class="qb-btn" data-action="announceEntry" data-uuid="{{selectedLore.uuid}}"
                    data-tooltip="{{localize 'STORYFLOW_DUNGEONS_LAB.QuestBoard.AnnounceHint'}}">
              <i class="fa-solid fa-bell"></i> {{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.Announce"}}
            </button>
            <span class="qb-spacer"></span>
            <button type="button" class="qb-btn-danger" data-action="deleteEntry" data-uuid="{{selectedLore.uuid}}"
                    data-tooltip="{{localize 'STORYFLOW_DUNGEONS_LAB.QuestBoard.DeleteEntry'}}">
              <i class="fa-solid fa-trash"></i> {{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.Delete"}}
            </button>
          </div>
          <p class="qb-section-label">{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.Description"}}</p>
          <textarea class="qb-desc-edit" data-edit="description" rows="12">{{selectedLore.description}}</textarea>
        {{else}}
          <div class="qb-description">{{{selectedLore.enrichedDescription}}}</div>
        {{/if}}
      {{else}}
        <div class="qb-empty-state">
          <i class="fa-solid fa-book"></i>
          <div class="qb-empty-title">{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.EmptyLoreTitle"}}</div>
          <div class="qb-empty-text">
            {{#if isGM}}{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.EmptyLoreGM"}}{{else}}{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.EmptyLorePlayer"}}{{/if}}
          </div>
        </div>
      {{/if}}
    </div>
  </div>

  <footer class="qb-footer">
    <span class="qb-footer-note">
      <i class="fa-solid {{#if isGM}}fa-crown{{else}}fa-check-to-slot{{/if}}"></i>
      {{#if isGM}}{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.FooterGM"}}{{else}}{{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.FooterPlayer"}}{{/if}}
    </span>
    {{#if isGM}}
      <button type="button" class="qb-primary-btn" data-action="addLore">
        <i class="fa-solid fa-plus"></i> {{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.NewLore"}}
      </button>
    {{/if}}
  </footer>
</section>
