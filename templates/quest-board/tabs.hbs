{{!-- Quest Board tab nav (Dungeons LAB candlelit design). --}}
<nav class="storyflow-qb-tabs">
  <a class="qb-tab {{#if (eq activeTab 'quests')}}active{{/if}}" data-action="switchTab" data-tabid="quests">
    <i class="fa-solid fa-scroll"></i> {{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.Quests"}}
  </a>
  <a class="qb-tab {{#if (eq activeTab 'lore')}}active{{/if}}" data-action="switchTab" data-tabid="lore">
    <i class="fa-solid fa-book"></i> {{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.Lore"}}
  </a>
  <a class="qb-tab {{#if (eq activeTab 'notes')}}active{{/if}}" data-action="switchTab" data-tabid="notes">
    <i class="fa-solid fa-pen"></i> {{localize "STORYFLOW_DUNGEONS_LAB.QuestBoard.Notes"}}
  </a>
  {{!-- Factions live in the standalone Faction Codex - no board tab, just the button.
        Hidden in builds that exclude the gated "app.factions-ui" package. --}}
  {{#if hasFactions}}
    <button type="button" class="qb-codex-btn" data-action="openFactionCodex">
      <i class="fa-solid fa-shield-halved"></i> {{localize "STORYFLOW_DUNGEONS_LAB.Factions.Codex.OpenButton"}}
      <i class="fa-solid fa-arrow-up-right-from-square qb-ext"></i>
    </button>
  {{/if}}
</nav>
